# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Server Port (Railway sets this automatically)
PORT=3001

# Database (Render + Hostinger: use MySQL URL from Hostinger panel)
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE
# Local SQLite (DB files live in data/): file:./data/dev.db
DATABASE_URL="mysql://user:password@localhost:3306/hbm"

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=office@thehbm.org
SMTP_PASS=your-app-password-here
SMTP_FROM=The HBM <office@thehbm.org>

# Admin Password
ADMIN_PASSWORD=hbm2026

# Optional: AI (Email Architect improve-copy, Site Content Magic Fetch books/videos). https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Free tier: Gemini allows many requests/day (e.g. 15/min); effectively dozens of books per day for free.
# Optional: Google Books (better rate limits for Magic Fetch book covers). Without key: ~100 req/day; with key: 1000/day.
# GOOGLE_BOOKS_API_KEY=your-google-books-key

# Environment
NODE_ENV=production

# FTP/SFTP — Upload assets to Hostinger (public_html/assets/). Required for /api/upload-asset and /api/upload-email-image on Render.
FTP_HOST=your-hostinger-ftp-host
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password
# Optional: set to 1 or true for implicit TLS (e.g. port 990)
# FTP_SECURE=0
# Optional: base URL for returned asset links (default https://thehbm.org)
# ASSETS_BASE_URL=https://thehbm.org

# --- Frontend Analytics (Vite; restart dev after change) ---
# GA4: Measurement ID (GA4 Admin → Data Streams → hbmFrontEnd)
VITE_GA_ID=G-BR4CGS5B7X
# Microsoft Clarity: Project ID (Heatmaps, Recordings, clarity.microsoft.com)
VITE_CLARITY_ID=vjvlklwjdb
