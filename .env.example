# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Server Port (Railway sets this automatically)
PORT=3001

# Database Configuration (SQLite)
# For development: file:./dev.db
# For production: file:./prisma/production.db or cloud database URL
DATABASE_URL="file:./dev.db"

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=office@thehbm.org
SMTP_PASS=your-app-password-here
SMTP_FROM=The HBM <office@thehbm.org>

# Admin Password
ADMIN_PASSWORD=hbm2026

# Optional: AI (Email Architect improve-copy, Site Content Magic Fetch books/videos). https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-gemini-api-key
# Optional: Google Books (better rate limits for Magic Fetch book covers)
# GOOGLE_BOOKS_API_KEY=your-google-books-key

# Environment
NODE_ENV=production

# --- Frontend Analytics (Vite; restart dev after change) ---
# GA4: Measurement ID (GA4 Admin → Data Streams → hbmFrontEnd)
VITE_GA_ID=G-BR4CGS5B7X
# Microsoft Clarity: Project ID (Heatmaps, Recordings, clarity.microsoft.com)
VITE_CLARITY_ID=vjvlklwjdb
