hatsappUrl(lang)\n\n  return (\n    <div className=\"min-h-screen flex flex-col\">\n      <Navbar />\n      <main className=\"flex-1\">\n        <Outlet />\n      </main>\n      <Footer />\n      <a href={whatsappUrl} target=\"_blank\" rel=\"noopener noreferrer\"\n        className=\"whatsapp-float\" aria-label=\"Contact us on WhatsApp\">\n        <MessageCircle size={28} className=\"text-white\" />\n      </a>\n    </div>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/components/Navbar.jsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n  30 |   }, [])\n  31 |\n> 32 |   useEffect(() => { setMobileOpen(false) }, [location.pathname])\n     |                     ^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  33 |\n  34 |   const isActive = (path) => location.pathname === path\n  35 |","line":32,"column":21,"nodeType":null,"endLine":32,"endColumn":34}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react'\nimport { Link, useLocation } from 'react-router-dom'\nimport { Menu, X } from 'lucide-react'\nimport { siteContent } from '../data/content'\nimport { useI18n, t } from '../i18n/context'\nimport { ui } from '../i18n/translations'\nimport LanguageSwitcher from './LanguageSwitcher'\n\nconst { global } = siteContent\n\n// V7: 5 main nav items\nconst navItems = [\n  { key: 'home', path: '/' },\n  { key: 'meeter', path: '/meeter' },\n  { key: 'events', path: '/events' },\n  { key: 'knowledge', path: '/knowledge' },\n  { key: 'about', path: '/about' },\n]\n\nexport default function Navbar() {\n  const [mobileOpen, setMobileOpen] = useState(false)\n  const [scrolled, setScrolled] = useState(false)\n  const location = useLocation()\n  const { lang } = useI18n()\n\n  useEffect(() => {\n    const onScroll = () => setScrolled(window.scrollY > 20)\n    window.addEventListener('scroll', onScroll)\n    return () => window.removeEventListener('scroll', onScroll)\n  }, [])\n\n  useEffect(() => { setMobileOpen(false) }, [location.pathname])\n\n  const isActive = (path) => location.pathname === path\n\n  return (\n    <header className={`sticky top-0 z-50 transition-all duration-300 ${\n      scrolled ? 'bg-white/95 backdrop-blur-md shadow-sm' : 'bg-white'\n    }`}>\n      <div className=\"max-w-7xl mx-auto px-6 flex items-center justify-between h-16 md:h-20\">\n        <Link to=\"/\" className=\"flex items-center gap-2 group\">\n          <img src={global.logo} alt=\"The HBM\" className=\"h-9 md:h-11 w-auto\" />\n          <span className=\"text-lg md:text-xl font-bold font-[var(--font-display)]\">\n            <span className=\"text-hbm-dark\">The</span>{' '}\n            <span className=\"text-hbm-purple\">HBM</span>\n          </span>\n        </Link>\n\n        <nav className=\"hidden md:flex items-center gap-10\">\n          {navItems.map((item) => (\n            <Link key={item.path} to={item.path}\n              className={`text-[15px] font-medium transition-colors relative pb-1 ${\n                isActive(item.path)\n                  ? 'text-hbm-purple after:absolute after:bottom-0 after:left-0 after:right-0 after:h-0.5 after:bg-hbm-orange after:rounded-full'\n                  : 'text-hbm-dark hover:text-hbm-purple'\n              }`}>\n              {t(ui.nav[item.key], lang)}\n            </Link>\n          ))}\n        </nav>\n\n        <div className=\"hidden md:flex items-center gap-3\">\n          <LanguageSwitcher />\n          <a href={global.ctaUrl} className=\"btn-primary text-sm py-3 px-7\">\n            {t(ui.cta.your8min, lang)}\n          </a>\n        </div>\n\n        <div className=\"flex md:hidden items-center gap-2\">\n          <LanguageSwitcher />\n          <button className=\"p-2 text-hbm-dark\" onClick={() => setMobileOpen(!mobileOpen)}>\n            {mobileOpen ? <X size={24} /> : <Menu size={24} />}\n          </button>\n        </div>\n      </div>\n\n      {mobileOpen && (\n        <div className=\"md:hidden bg-white border-t border-gray-100 px-6 py-6 space-y-4 shadow-lg\">\n          {navItems.map((item) => (\n            <Link key={item.path} to={item.path}\n              className={`block py-2 text-lg font-medium ${\n                isActive(item.path) ? 'text-hbm-purple' : 'text-hbm-dark'\n              }`}>\n              {t(ui.nav[item.key], lang)}\n            </Link>\n          ))}\n          <a href={global.ctaUrl} className=\"btn-primary block text-center mt-4\">\n            {t(ui.cta.your8min, lang)}\n          </a>\n        </div>\n      )}\n    </header>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/components/SEO.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/data/content.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-back