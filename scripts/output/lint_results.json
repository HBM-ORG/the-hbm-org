e but never used. Allowed unused vars must match /^[A-Z_]/u.","line":479,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":479,"endColumn":22,"suggestions":[{"messageId":"removeVar","data":{"varName":"addToEmailQueue"},"fix":{"range":[19593,19652],"text":""},"desc":"Remove unused variable 'addToEmailQueue'."}]},{"ruleId":"no-unused-vars","severity":2,"message":"'sequenceId' is defined but never used.","line":479,"column":32,"nodeType":"Identifier","messageId":"unusedVar","endLine":479,"endColumn":42,"suggestions":[{"messageId":"removeVar","data":{"varName":"sequenceId"},"fix":{"range":[19624,19635],"text":""},"desc":"Remove unused variable 'sequenceId'."}]},{"ruleId":"no-unused-vars","severity":2,"message":"'userData' is defined but never used.","line":479,"column":44,"nodeType":"Identifier","messageId":"unusedVar","endLine":479,"endColumn":52,"suggestions":[{"messageId":"removeVar","data":{"varName":"userData"},"fix":{"range":[19634,19644],"text":""},"desc":"Remove unused variable 'userData'."}]},{"ruleId":"no-unused-vars","severity":2,"message":"'parseDelay' is assigned a value but never used. Allowed unused vars must match /^[A-Z_]/u.","line":481,"column":7,"nodeType":"Identifier","messageId":"unusedVar","endLine":481,"endColumn":17,"suggestions":[{"messageId":"removeVar","data":{"varName":"parseDelay"},"fix":{"range":[19654,19907],"text":""},"desc":"Remove unused variable 'parseDelay'."}]},{"ruleId":"no-unused-vars","severity":2,"message":"'e' is defined but never used.","line":598,"column":13,"nodeType":"Identifier","messageId":"unusedVar","endLine":598,"endColumn":14},{"ruleId":"no-empty","severity":2,"message":"Empty block statement.","line":598,"column":16,"nodeType":"BlockStatement","messageId":"unexpected","endLine":598,"endColumn":18,"suggestions":[{"messageId":"suggestComment","data":{"type":"block"},"fix":{"range":[24682,24682],"text":" /* empty */ "},"desc":"Add comment inside empty block statement."}]},{"ruleId":"no-undef","severity