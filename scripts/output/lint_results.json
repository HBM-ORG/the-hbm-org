dir || 'ltr')\n  }, [lang])\n\n  return (\n    <I18nContext.Provider value={{ lang, setLang }}>\n      {children}\n    </I18nContext.Provider>\n  )\n}\n\nexport function useI18n() {\n  return useContext(I18nContext)\n}\n\n// Translation helper - returns translated text or falls back to English\nexport function t(translations, lang) {\n  if (typeof translations === 'string') return translations\n  return translations?.[lang] || translations?.en || translations?.he || ''\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/i18n/translations.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/i18n/useT.js","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/main.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/pages/About.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/pages/B2B.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'g' is assigned a value but never used. Allowed unused vars must match /^[A-Z_]/u.","line":8,"column":22,"nodeType":"Identifier","messageId":"unusedVar","endLine":8,"endColumn":23,"suggestions":[{"messageId":"removeVar","data":{"varName":"g"},"fix":{"range":[265,276],"text":""},"desc":"Remove unused variable 'g'."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from 'react'\nimport { ArrowRight } from 'lucide-react'\nimport { siteContent } from '../data/content'\nimport { useI18n } from '../i18n/context'\nimport { useT } from '../i18n/useT'\nimport { getWhatsappUrl } from '../components/Layout'\n\nconst { b2b, global: g } = siteContent\n\nfunction B2BHero() {\n  const t = useT()\n  return (\n    <section className=\"section-padding bg-hbm-dark text-white text-center\">\n      <div className=\"max-w-4xl mx-auto\">\n        <h1 className=\"text-4xl md:text-6xl font-[var(--font-display)] mb-6\">{t(b2b.headline)}</h1>\n        <p className=\"text-lg md:text-xl text-white/80 max-w-3xl mx-auto\">{t(b2b.description)}</p>\n      </div>\n    </section>\n  )\n}\n\nfunction TabsSection() {\n  const [activeTab, setActiveTab] = useState(0)\n  const t = useT()\n  return (\n    <section className=\"relative overflow-hidden\">\n      <div className=\"relative min-h-[550px]\">\n        <video key={b2b.tabs[activeTab].bgVideo} src={b2b.tabs[activeTab].bgVideo} autoPlay muted loop playsInline className=\"absolute inset-0 w-full h-full object-cover\" />\n        <div className=\"absolute inset-0 bg-black/60\" />\n        <div className=\"relative z-10 section-padding\">\n          <div className=\"max-w-6xl mx-auto\">\n            <div className=\"flex flex-wrap gap-3 mb-12 justify-center\">\n              {b2b.tabs.map((tab, i) => (\n                <button key={i} onClick={() => setActiveTab(i)}\n                  className={`px-6 py-3 rounded-full text-sm font-semibold transition-all ${i === activeTab ? 'bg-white text-hbm-dark' : 'bg-white/10 text-white hover:bg-white/20'}`}>\n                  {t(tab.label)}\n                </button>\n              ))}\n            </div>\n            <div className=\"grid md:grid-cols-3 gap-6\">\n              {b2b.tabs[activeTab].cards.map((card, i) => (\n                <div key={i} className=\"bg-white/10 backdrop-blur-md p-8 rounded-2xl text-white border border-white/10\">\n                  <h3 className=\"text-xl font-bold mb-3\">{t(card.title)}</h3>\n                  <p className=\"text-white/80 leading-relaxed\">{t(card.text)}</p>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n\nfunction AdminFlow() {\n  const t = useT()\n  return (\n    <section className=\"section-padding bg-white\">\n      <div className=\"max-w-6xl mx-auto\">\n        <h2 className=\"text-3xl md:text-4xl font-[var(--font-display)] text-hbm-blue text-center mb-4\">{t(b2b.adminFlow.title)}</h2>\n        <p className=\"text-center text-hbm-gray mb-12 max-w-2xl mx-auto\">{t(b2b.adminFlow.subtitle)}</p>\n        <div className=\"grid md:grid-cols-4 gap-8\">\n          {b2b.adminFlow.steps.map((step, i) => (\n            <div key={i} className=\"text-center\">\n              <div className=\"w-16 h-16 rounded-full bg-hbm-blue/10 flex items-center justify-center mx-auto mb-4\">\n                <span className=\"text-2xl font-bold text-hbm-blue\">{i + 1}</span>\n              </div>\n              <h4 className=\"font-bold text-hbm-dark mb-2\">{t(step.title)}</h4>\n              <p className=\"text-sm text-hbm-gray\">{t(step.text)}</p>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  )\n}\n\nfunction ThriveStatement() {\n  const t = useT()\n  return (\n    <section className=\"section-padding bg-hbm-cream/30\">\n      <div className=\"max-w-4xl mx-auto text-center\">\n        <h2 className=\"text-3xl md:text-5xl font-[var(--font-display)] text-hbm-dark mb-4\">{t(b2b.thriveStatement.bigTitle)}</h2>\n        <p className=\"text-lg text-hbm-gray\">{t(b2b.thriveStatement.smallTitle)}</p>\n      </div>\n    </section>\n  )\n}\n\nfunction StepsSection() {\n  const t = useT()\n  return (\n    <section className=\"section-padding bg-white\">\n      <div className=\"max-w-6xl mx-auto\">\n        <h2 className=\"text-3xl md:text-4xl font-[var(--font-display)] text-center mb-2\">{t(b2b.steps.title)}</h2>\n        <p className=\"text-center text-hbm-dark font-bold text-xl mb-14\">{t(b2b.steps.subtitle)}</p>\n        <div className=\"grid md:grid-cols-2 gap-12 items-center\">\n          <div className=\"space-y-8\">\n            {b2b.steps.items.map((step, i) => (\n              <div key={i} className=\"flex items-start gap-4\">\n                <div className=\"w-10 h-10 rounded-full bg-hbm-coral/10 flex items-center justify-center flex-shrink-0\">\n                  <span className=\"font-bold text-hbm-coral\">{i + 1}</span>\n                </div>\n                <div>\n                  <h4 className=\"font-bold text-hbm-dark mb-1\">{t(step.title)}</h4>\n                  <p className=\"text-hbm-gray\">{t(step.text)}</p>\n                </div>\n              </div>\n            ))}\n          </div>\n          <div className=\"flex justify-center\">\n            <img src={b2b.steps.phoneMockup} alt=\"HBM Platform\" className=\"phone-mockup\" />\n          </div>\n        </div>\n      </div>\n    </section>\n  )\n}\n\nfunction CTASection() {\n  const t = useT()\n  const { lang } = useI18n()\n  return (\n    <section className=\"section-padding bg-hbm-blue text-white text-center\">\n      <div className=\"max-w-3xl mx-auto\">\n        <h2 className=\"text-3xl md:text-4xl font-[var(--font-display)] mb-3\">{t(b2b.cta.title)}</h2>\n        <p className=\"text-xl mb-8 text-white/80\">{t(b2b.cta.subtitle)}</p>\n        <a href={getWhatsappUrl(lang)} target=\"_blank\" rel=\"noopener noreferrer\" className=\"btn-primary text-lg px-10 py-4 bg-white text-hbm-blue hover:bg-gray-100\">\n          {t(b2b.cta.ctaText)} <ArrowRight size={20} />\n        </a>\n      </div>\n    </section>\n  )\n}\n\nexport default function B2B() {\n  return (\n    <>\n      <B2BHero />\n      <TabsSection />\n      <AdminFlow />\n      <ThriveStatement />\n      <StepsSection />\n      <CTASection />\n    </>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/pages/Contact.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/pages/Events.jsx","messages":[{"ruleId":"no-unused-vars","severity":2,"message":"'lang' is assigned a value but never used. Allowed unused vars must match /^[A-Z_]/u.","line":63,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":63,"endColumn":15},{"ruleId":"no-unused-vars","severity":2,"message":"'i' is defined but never used.","line":180,"column":38,"nodeType":"Identifier","messageId":"unusedVar","endLine":180,"endColumn":39,"suggestions":[{"messageId":"removeVar","data":{"varName":"i"},"fix":{"range":[7604,7607],"text":""},"desc":"Remove unused variable 'i'."}]}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState } from 'react'\nimport { Calendar, MapPin, ArrowLeft, ExternalLink } from 'lucide-react'\nimport { siteContent } from '../data/content'\nimport { useI18n } from '../i18n/context'\nimport { useT } from '../i18n/useT'\nimport { getWhatsappUrl } from '../components/Layout'\n\nconst { events } = siteContent\n\nfunction formatDate(dateStr) {\n  const d = new Date(dateStr)\n  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC']\n  return { month: months[d.getMonth()], day: d.getDate(), year: d.getFullYear() }\n}\n\nfunction EventCard({ event, onClick, isUpcoming }) {\n  const t = useT()\n  const date = formatDate(event.date)\n  return (\n    <div onClick={onClick} className=\"bg-white rounded-2xl overflow-hidden card-hover cursor-pointer border border-gray-100 group\">\n      {/* Cover */}\n      <div className=\"relative h-48 bg-gradient-to-br from-hbm-blue/20 to-hbm-lavender/30 overflow-hidden\">\n        {event.coverImage ? (\n          <img src={event.coverImage} alt=\"\" className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\" />\n        ) : (\n          <div className=\"w-full h-full flex items-center justify-center\">\n            <span className=\"text-6xl opacity-30\">🤝</span>\n          </div>\n        )}\n        {/* Date badge */}\n        <div className=\"absolute top-4 left-4 bg-white rounded-xl px-3 py-2 shadow-lg text-center\">\n          <span className=\"text-xs font-bold text-hbm-blue block\">{date.month}</span>\n          <span className=\"text-2xl font-bold text-hbm-dark block leading-none\">{date.day}</span>\n        </div>\n        {event.type && (\n          <span className=\"absolute top-4 right-4 bg-hbm-dark/70 text-white text-xs font-semibold px-3 py-1 rounded-full\">{event.type}</span>\n        )}\n      </div>\n\n      {/* Content */}\n      <div className=\"p-6\">\n        <h3 className=\"font-bold text-lg text-hbm-dark mb-2 group-hover:text-hbm-blue transition-colors\">{t(event.title)}</h3>\n        <p className=\"text-hbm-gray text-sm mb-3 line-clamp-2\">{t(event.description)}</p>\n        {event.location && (\n          <div className=\"flex items-center gap-1.5 text-xs text-hbm-gray\">\n            <MapPin size={14} />\n            <span>{t(event.location)}</span>\n          </div>\n        )}\n        {isUpcoming && event.registerUrl && (\n          <a href={event.registerUrl} onClick={e => e.stopPropagation()}\n            className=\"btn-primary text-sm py-2.5 px-6 mt-4 w-full\">\n            {t({ en: 'Register', he: 'הרשמה' })}\n          </a>\n        )}\n      </div>\n    </div>\n  )\n}\n\nfunction EventDetail({ event, onBack }) {\n  const t = useT()\n  const { lang } = useI18n()\n  const date = formatDate(event.date)\n  const hasGallery = event.gallery && event.gallery.length > 0\n\n  return (\n    <div>\n      <button onClick={onBack} className=\"flex items-center gap-2 text-hbm-blue hover:text-hbm-dark transition-colors mb-8 font-medium\">\n        <ArrowLeft size={18} />\n        {t({ en: 'Back to Events', he: 'חזרה לאירועים' })}\n      </button>\n\n      {/* Hero */}\n      <div className=\"relative rounded-2xl overflow-hidden mb-8 h-64 md:h-80\">\n        {event.coverImage ? (\n          <img src={event.coverImage} alt=\"\" className=\"w-full h-full object-cover\" />\n        ) : (\n          <div className=\"w-full h-full bg-gradient-to-br from-hbm-blue/20 to-hbm-coral/20 flex items-center justify-center\">\n            <span className=\"text-8xl opacity-20\">🤝</span>\n          </div>\n        )}\n        <div className=\"absolute inset-0 bg-black/30\" />\n        <div className=\"absolute bottom-6 left-6 text-white\">\n          <div className=\"flex items-center gap-3 mb-2\">\n            <div className=\"bg-white rounded-xl px-3 py-2 text-center\">\n              <span className=\"text-xs font-bold text-hbm-blue block\">{date.month}</span>\n              <span className=\"text-2xl font-bold text-hbm-dark block leading-none\">{date.day}</span>\n            </div>\n            <div>\n              <h1 className=\"text-2xl md:text-3xl font-bold\">{t(event.title)}</h1>\n              {event.location && (\n                <p className=\"flex items-center gap-1 text-white/80 text-sm mt-1\">\n                  <MapPin size={14} /> {t(event.location)}\n                </p>\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Description */}\n      <div className=\"mb-12\">\n        <p className=\"text-lg text-hbm-gray leading-relaxed\">{t(event.description)}</p>\n        {event.registerUrl && event.registerUrl !== '#' && (\n          <a href={event.registerUrl} className=\"btn-primary mt-6 inline-flex\">\n            {t({ en: 'Register Now', he: 'הירשמו עכשיו' })} <ExternalLink size={16} />\n          </a>\n        )}\n      </div>\n\n      {/* Gallery */}\n      <div>\n        <h2 className=\"text-2xl font-[var(--font-display)] text-hbm-blue mb-6\">\n          {t({ en: 'Event Gallery', he: 'גלריית האירוע' })}\n        </h2>\n        {hasGallery ? (\n          <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3\">\n            {event.gallery.map((img, i) => (\n              <div key={i} className=\"aspect-square rounded-xl overflow-hidden\">\n                <img src={img} alt=\"\" className=\"w-full h-full object-cover hover:scale-105 transition-transform duration-300\" />\n              </div>\n            ))}\n          </div>\n        ) : (\n          <div className=\"grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3\">\n            {[1,2,3,4,5,6,7,8].map(i => (\n              <div key={i} className=\"aspect-square rounded-xl bg-gray-100 flex items-center justify-center\">\n                <span className=\"text-3xl text-gray-300\">📸</span>\n              </div>\n            ))}\n          </div>\n        )}\n        <p className=\"text-center text-hbm-gray/50 text-sm mt-4\">\n          {t({ en: 'Photos will be uploaded after the event', he: 'תמונות יועלו לאחר האירוע' })}\n        </p>\n      </div>\n    </div>\n  )\n}\n\nexport default function Events() {\n  const [selectedEvent, setSelectedEvent] = useState(null)\n  const [tab, setTab] = useState('upcoming')\n  const t = useT()\n  const { lang } = useI18n()\n\n  const currentEvents = tab === 'upcoming' ? events.upcoming : events.past\n\n  if (selectedEvent) {\n    return (\n      <section className=\"section-padding bg-white\">\n        <div className=\"max-w-5xl mx-auto\">\n          <EventDetail event={selectedEvent} onBack={() => setSelectedEvent(null)} />\n        </div>\n      </section>\n    )\n  }\n\n  return (\n    <section className=\"section-padding bg-white\">\n      <div className=\"max-w-6xl mx-auto\">\n        <h1 className=\"text-4xl md:text-5xl font-[var(--font-display)] text-hbm-blue text-center mb-4\">{t(events.title)}</h1>\n        <p className=\"text-center text-hbm-gray max-w-2xl mx-auto mb-10\">{t(events.subtitle)}</p>\n\n        {/* Tab toggle */}\n        <div className=\"flex justify-center gap-4 mb-12\">\n          <button onClick={() => setTab('upcoming')}\n            className={`px-8 py-3 rounded-full font-semibold transition-all ${tab === 'upcoming' ? 'bg-hbm-blue text-white' : 'bg-gray-100 text-hbm-dark hover:bg-gray-200'}`}>\n            {t({ en: 'Upcoming', he: 'קרובים' })}\n          </button>\n          <button onClick={() => setTab('past')}\n            className={`px-8 py-3 rounded-full font-semibold transition-all ${tab === 'past' ? 'bg-hbm-blue text-white' : 'bg-gray-100 text-hbm-dark hover:bg-gray-200'}`}>\n            {t({ en: 'Past Events', he: 'אירועים קודמים' })}\n          </button>\n        </div>\n\n        {/* Events grid */}\n        <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {currentEvents.map((event, i) => (\n            <EventCard key={event.id} event={event} isUpcoming={tab === 'upcoming'}\n              onClick={() => setSelectedEvent(event)} />\n          ))}\n        </div>\n\n        {/* CTA */}\n        <div className=\"text-center mt-16\">\n          <p className=\"text-hbm-gray mb-4\">{t({ en: 'Want to host an event with HBM?', he: 'רוצים לארגן אירוע עם HBM?' })}</p>\n          <a href={getWhatsappUrl(lang)} target=\"_blank\" rel=\"noopener noreferrer\" className=\"btn-primary\">\n            {t({ en: \"Let's Talk\", he: 'בואו נדבר' })}\n          </a>\n        </div>\n      </div>\n    </section>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/pages/Gallery.jsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/yuvalhefetz/Downloads/the-hbm-org/src-backup-v6/pages/Home.jsx","message