# Copy to apps/site/.env for public site configuration.

# Local default: shared API during development.
# Production examples:
# VITE_API_BASE=https://api.thehbm.org
# VITE_API_BASE=https://staging-api.thehbm.org
VITE_API_BASE=http://localhost:3001

# Local default for canonical/site links during development.
# Production example:
# VITE_SITE_URL=https://www.thehbm.org
VITE_SITE_URL=http://localhost:4200

# Local default for links from site -> admin.
# Production example:
# VITE_ADMIN_URL=https://admin.thehbm.org
VITE_ADMIN_URL=http://localhost:4300

# Optional explicit OG image URL for HTML head tags.
# Set VITE_SITE_OG_IMAGE_URL explicitly when OG images are not served from the site origin.
VITE_SITE_OG_IMAGE_URL=

# Analytics / pixels
VITE_GA_ID=your-ga4-measurement-id
VITE_CLARITY_ID=your-clarity-project-id
VITE_FB_PIXEL_ID=your-facebook-pixel-id

# Do not put AI or Google Books keys in frontend env files.
# Keep GOOGLE_BOOKS_API_KEY, GEMINI_API_KEY, and OPENAI_API_KEY in apps/server/.env only.
