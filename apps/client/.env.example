# Copy to apps/client/.env for client-only local configuration.

# Optional API override for local frontend development
# VITE_API_BASE=http://localhost:3001

# Analytics / pixels
# --- Frontend Analytics (Vite; restart dev after change) ---
# GA4: Measurement ID (GA4 Admin → Data Streams → hbmFrontEnd)
VITE_GA_ID=your-ga4-measurement-id

# Microsoft Clarity: Project ID (Heatmaps, Recordings, clarity.microsoft.com)
VITE_CLARITY_ID=your-clarity-project-id

# Facebook Pixel: ID (Meta Ads, facebook.com/ads/manager)
VITE_FB_PIXEL_ID=your-facebook-pixel-id

# Optional client-side services
VITE_GOOGLE_BOOKS_API_KEY=your-google-books-key
