{
  "name": "@thehbm/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/web.ts",
    "start": "tsx src/web.ts",
    "web": "tsx src/web.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck",
    "validate": "npm run prisma:generate && npm run build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:json-to-db": "tsx ../../scripts/one-off/migrate-json-to-db.ts",
    "migrate:json-to-db:dry": "tsx ../../scripts/one-off/migrate-json-to-db.ts --dry-run",
    "migrate:engagement-to-db": "tsx ../../scripts/one-off/migrate-engagement-log-to-db.ts",
    "migrate:files-to-storage": "tsx ../../scripts/one-off/migrate-files-to-storage.ts",
    "migrate:files-to-storage:dry": "tsx ../../scripts/one-off/migrate-files-to-storage.ts --dry-run",
    "migrate:files-to-storage:update-db-only": "tsx ../../scripts/one-off/migrate-files-to-storage.ts --update-db-only",
    "migrate:storage-provider": "tsx ../../scripts/one-off/migrate-storage-provider.ts",
    "migrate:storage-provider:dry": "tsx ../../scripts/one-off/migrate-storage-provider.ts --dry-run",
    "reconcile:event-assets": "tsx ../../scripts/one-off/reconcile-event-assets.ts",
    "reconcile:event-assets:dry": "tsx ../../scripts/one-off/reconcile-event-assets.ts --dry-run",
    "migrate:all": "npm run migrate:json-to-db && npm run migrate:files-to-storage",
    "migrate:all:dry": "npm run migrate:json-to-db:dry && npm run migrate:files-to-storage:dry"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@google-cloud/storage": "^7.15.2",
    "@prisma/adapter-mariadb": "^7.4.1",
    "@prisma/client": "^6.19.2",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "heic-convert": "^2.1.0",
    "ics": "^3.8.1",
    "inline-css": "^4.0.3",
    "liquidjs": "^10.24.0",
    "nodemailer": "^8.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/nodemailer": "^7.0.11",
    "prisma": "^6.19.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
