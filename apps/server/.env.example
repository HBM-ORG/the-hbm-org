# Copy to apps/server/.env for server-only local configuration.
# Root .env is still read as a fallback during transition.

NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001
SITE_PUBLIC_URL=https://www.thehbm.org
SITE_APP_URL=http://localhost:4200
ADMIN_APP_URL=http://localhost:4300
RUN_EMAIL_WORKER=false

# Required in non-trivial environments
DATABASE_URL="mysql://user:password@localhost:3306/hbm"
ADMIN_PASSWORD=change-me

# Optional SMTP fallback when DB config is empty
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# SMTP_SECURE=false

# Brevo
BREVO_API_URL=https://api.brevo.com/v3
BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
# Comma-separated label:id pairs, e.g. general:12,event:13,video:14,newsletter:15
BREVO_LIST_IDS=

# EspoCRM
ESPOCRM_URL=
ESPOCRM_API_KEY=
ESPOCRM_WEBHOOK_SECRET=
ESPOCRM_CONTACT_ENTITY=Contact

# UI/runtime defaults
DEFAULT_SMTP_HOST=smtp.office365.com
DEFAULT_SMTP_PORT=587
DEFAULT_SMTP_FROM=The HBM <office@thehbm.org>
EMAIL_PRIMARY_COLOR=#6160AB
EMAIL_SECONDARY_COLOR=#F07B3C
EMAIL_LOGO_URL=/logo.png
EMAIL_FONT_FAMILY=Sora, sans-serif
DEFAULT_VIDEO_EVENT_TITLE_EN=Video Event
DEFAULT_VIDEO_EVENT_TITLE_HE=אירוע וידאו
DEFAULT_VIDEO_EVENT_TIME=20:00
DEFAULT_VIDEO_EVENT_LOCATION=Zoom / Video Call

# AI / enrichment
# GEMINI_API_KEY=
# GOOGLE_BOOKS_API_KEY=
# OPENAI_API_KEY=

# Object storage
STORAGE_PROVIDER=spaces

# DigitalOcean Spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=

# Google Cloud Storage
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_CREDENTIALS_JSON={"type":"service_account",...}
# GCS_KEY_FILE=/absolute/path/to/key.json
