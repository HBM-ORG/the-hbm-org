# Copy to apps/admin/.env for admin console configuration.

# Local default: shared API during development.
# Production example:
# VITE_API_BASE=https://api.thehbm.org
VITE_API_BASE=http://localhost:3001

# Local default for links from admin -> public site.
# Production example:
# VITE_SITE_URL=https://www.thehbm.org
VITE_SITE_URL=http://localhost:4200

# Local default for admin app links and future auth/session flows.
# Production example:
# VITE_ADMIN_URL=https://admin.thehbm.org
VITE_ADMIN_URL=http://localhost:4300

# Optional if the admin dashboard should deep-link to a Clarity project.
VITE_CLARITY_ID=your-clarity-project-id

# Do not put GA / Facebook Pixel / AI / Google Books keys in admin frontend env files
# unless the admin app explicitly starts using them. AI and book enrichment remain server-side.
