{
  "name": "thehbm-site-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/client",
    "apps/server"
  ],
  "scripts": {
    "postinstall": "npm run prisma:generate -w apps/server",
    "dev": "concurrently \"npm run dev -w apps/client\" \"npm run dev -w apps/server\"",
    "dev:admin": "npm run dev",
    "dev:client": "npm run dev -w apps/client",
    "dev:server": "npm run dev -w apps/server",
    "start": "npm run start -w apps/server",
    "start:worker": "npm run worker -w apps/server",
    "build": "npm run build -w apps/client",
    "build:client": "npm run build -w apps/client",
    "build:server": "npm run build -w apps/server",
    "typecheck": "npm run typecheck -w apps/server",
    "lint": "eslint . --config config/eslint.config.js",
    "preview": "npm run preview -w apps/client",
    "generate-sitemap": "node scripts/build/generate-sitemap.js",
    "prisma:generate": "npm run prisma:generate -w apps/server",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy -w apps/server",
    "migrate:json-to-db": "npm run migrate:json-to-db -w apps/server",
    "migrate:json-to-db:dry": "npm run migrate:json-to-db:dry -w apps/server",
    "migrate:engagement-to-db": "npm run migrate:engagement-to-db -w apps/server",
    "migrate:files-to-storage": "npm run migrate:files-to-storage -w apps/server",
    "migrate:files-to-storage:dry": "npm run migrate:files-to-storage:dry -w apps/server",
    "migrate:files-to-storage:update-db-only": "npm run migrate:files-to-storage:update-db-only -w apps/server",
    "migrate:storage-provider": "npm run migrate:storage-provider -w apps/server",
    "migrate:storage-provider:dry": "npm run migrate:storage-provider:dry -w apps/server",
    "migrate:all": "npm run migrate:all -w apps/server",
    "migrate:all:dry": "npm run migrate:all:dry -w apps/server",
    "storage:status": "curl -s http://localhost:3001/api/upload/status | jq ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}
