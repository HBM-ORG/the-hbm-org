{
  "name": "thehbm-site-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "luxon": "^3.7.2"
  },
  "scripts": {
    "install:site": "npm ci --prefix apps/site",
    "install:admin": "npm ci --prefix apps/admin",
    "install:backend": "npm ci --prefix apps/server",
    "install:all": "npm ci && npm run install:site && npm run install:admin && npm run install:backend",
    "dev": "concurrently \"npm --prefix apps/site run dev\" \"npm --prefix apps/admin run dev\" \"npm --prefix apps/server run dev\"",
    "dev:admin": "concurrently \"npm --prefix apps/admin run dev\" \"npm --prefix apps/server run dev\"",
    "dev:admin-ui": "npm --prefix apps/admin run dev",
    "dev:client": "npm --prefix apps/site run dev",
    "dev:site": "npm --prefix apps/site run dev",
    "dev:server": "npm --prefix apps/server run dev",
    "start": "npm --prefix apps/server run start",
    "start:worker": "npm --prefix apps/server run worker",
    "build": "npm --prefix apps/site run build && npm --prefix apps/admin run build",
    "build:client": "npm --prefix apps/site run build",
    "build:site": "npm --prefix apps/site run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:frontends": "npm --prefix apps/site run build && npm --prefix apps/admin run build",
    "build:server": "npm --prefix apps/server run build",
    "validate:site": "npm --prefix apps/site run validate",
    "validate:admin": "npm --prefix apps/admin run validate",
    "validate:backend": "npm --prefix apps/server run validate",
    "typecheck": "npm --prefix apps/server run typecheck",
    "lint": "eslint . --config config/eslint.config.js",
    "preview": "npm --prefix apps/site run preview",
    "preview:admin": "npm --prefix apps/admin run preview",
    "generate-sitemap": "node scripts/build/generate-sitemap.js",
    "prisma:generate": "npm --prefix apps/server run prisma:generate",
    "prisma:migrate:deploy": "npm --prefix apps/server run prisma:migrate:deploy",
    "migrate:json-to-db": "npm --prefix apps/server run migrate:json-to-db",
    "migrate:json-to-db:dry": "npm --prefix apps/server run migrate:json-to-db:dry",
    "migrate:engagement-to-db": "npm --prefix apps/server run migrate:engagement-to-db",
    "migrate:files-to-storage": "npm --prefix apps/server run migrate:files-to-storage",
    "migrate:files-to-storage:dry": "npm --prefix apps/server run migrate:files-to-storage:dry",
    "migrate:files-to-storage:update-db-only": "npm --prefix apps/server run migrate:files-to-storage:update-db-only",
    "migrate:storage-provider": "npm --prefix apps/server run migrate:storage-provider",
    "migrate:storage-provider:dry": "npm --prefix apps/server run migrate:storage-provider:dry",
    "reconcile:event-assets": "npm --prefix apps/server run reconcile:event-assets",
    "reconcile:event-assets:dry": "npm --prefix apps/server run reconcile:event-assets:dry",
    "migrate:all": "npm --prefix apps/server run migrate:all",
    "migrate:all:dry": "npm --prefix apps/server run migrate:all:dry",
    "docker:build:backend": "docker build -f apps/server/Dockerfile .",
    "storage:status": "curl -s http://localhost:3001/api/upload/status | jq ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0"
  }
}
